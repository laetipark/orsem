# 로컬 미리보기 기본값입니다. 운영은 NODE_ENV=production과
# FIXTURE_MODE=false를 사용해야 하며, API는 운영에서 테스트 데이터 모드를 거절합니다.
NODE_ENV=development
PORT=3210
WEB_ORIGIN=http://localhost:5173
FIXTURE_MODE=true
LOG_LEVEL=info
TZ=Asia/Seoul

# 테스트 데이터 전용 로그인 (운영 모드에서는 무시)
FIXTURE_ADMIN_EMAIL=admin@orsem.local
FIXTURE_ADMIN_PASSWORD=orsem-fixture-admin

# React/Vite 개발 서버
VITE_PORT=5173
VITE_FIXTURE_MODE=true
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:3210
# Enable only after the manual translation migration and API are deployed.
VITE_NEWS_TRANSLATION_EDITOR_ENABLED=false

# 저장 경로 (운영 데이터는 저장소 밖에 보관)
ORSEM_DATA_DIR=/home/laeti/orsem-data
RAW_DOCUMENT_DIR=/home/laeti/orsem-data/raw

# MySQL 8 / Redis
DATABASE_URL=mysql://orsem:change-me@127.0.0.1:3306/orsem
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=orsem:

# 관리자 및 회원 인증
# 널리 알려진 예시 값이 운영 검증을 통과하지 않도록 여기서는 비워 둡니다.
# SESSION_SECRET에는 무작위 문자 32개 이상이 필요하며,
# TOTP_ENCRYPTION_KEY는 정확히 32바이트인 무작위 값의 정규 base64여야 합니다.
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# `npm run admin:create`에서 한 번만 사용할 수 있는 선택 입력입니다.
# --email을 사용하고 명령이 비밀번호를 생성하도록 하는 방식을 권장합니다.
# 실행 환경에 넣은 값은 사용한 뒤 즉시 제거합니다.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# 선택적인 카카오 가입·로그인입니다. 카카오디벨로퍼스에서 카카오 로그인과
# OpenID Connect를 모두 켜며, 콜백은 WEB_ORIGIN + /api/v1/auth/kakao/callback입니다.
# 일반 회원: /login, 로컬 관리자: /admin/login
# 권한 0600인 외부 JSON: {"clientId":"...","clientSecret":"..."}
# 예: /home/laeti/.config/orsem/credentials/kakao.json (clientId는 REST API 키)
# 서비스별 형식과 환경 변수 우선순위: docs/CREDENTIALS.md
KAKAO_CREDENTIALS_FILE=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 공식·공개 데이터 커넥터
OPENDART_API_KEY=
# 봇/공용 채널에 발송할 공시 유형. D003·D004는 명시적으로 추가한 경우에만 발송합니다.
# 빈 값은 모든 공시의 공용 채널 발송을 끕니다. 개인 브라우저 알림은 이용자 설정을 따릅니다.
OPENDART_GLOBAL_ALERT_TYPES=D001,D002,D005
# 차트 공급자는 토스만 사용하며, 이전 EOD 수집기는 사용을 종료했습니다.
MARKET_DATA_PROVIDER=toss
# 권장: 아래 내용을 담은 권한 0600의 외부 JSON 파일 절대 경로를 사용합니다.
# {"clientId":"...","clientSecret":"..."}. 실제 자격 증명은 저장소 밖에 보관합니다.
# 예: /home/laeti/.config/orsem/credentials/toss.json
TOSS_CREDENTIALS_FILE=
# 또는 프로세스 환경에 다음 값을 직접 주입합니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 실시간 통합 구독 대상 수를 제한합니다 (1–100개 기업).
TOSS_MAX_SUBSCRIPTIONS=100
# 선택 시장 지표: 키는 저장소 밖 runtime.env에서 프로세스에 주입합니다.
# GOLD_API_KEY: 금·은 이력 (현재가에는 불필요), EIA_API_KEY: WTI 현물 일별.
# 무료 발급과 수집 기준: docs/MARKET_INDICATORS.md
GOLD_API_KEY=
EIA_API_KEY=
# 모바일 브라우저 알림: npm run push:setup으로 저장소 밖 0600 JSON을 생성합니다.
# JSON: {"publicKey":"...","privateKey":"...","subject":"https://서비스주소"}
WEB_PUSH_CREDENTIALS_FILE=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# 토스 가격과 독립적인 선택 뉴스 발견 기능입니다.
# developers: NAVER 개발자센터, ncloud: NAVER Cloud API HUB. 기본값은 developers입니다.
# Client ID와 Secret은 선택한 공급자의 같은 Application에서 발급한 쌍이어야 합니다.
NAVER_API_PROVIDER=developers
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER 결과는 화면에서만 표시합니다. 검색어·결과를 DB에 저장하지 않습니다.
# 현재 계정의 무료 조건과 이번 달 할당량을 확인한 뒤 설정합니다. 미설정·만료 시 호출하지 않습니다.
# FREE_UNTIL: 시간대가 포함된 ISO 시각, FREE_MONTH: KST YYYY-MM.
# FREE_REQUESTS: 이 앱에 배정한 월 누적 상한(기존 사용량 포함). 계정 공유 앱의 사용량은 별도 차감합니다.
NAVER_NEWS_FREE_UNTIL=
NAVER_NEWS_FREE_MONTH=
NAVER_NEWS_FREE_REQUESTS=0
NAVER_NEWS_DAILY_LIMIT=1000
NAVER_NEWS_MONTHLY_LIMIT=30000
# SEC를 활성화하려면 애플리케이션 식별 정보와 실제 확인하는 연락처를 넣습니다.
SEC_USER_AGENT=Orsem monitored-email@example.com
# 선택적인 미국 기업·자산 식별 정보 동기화입니다. 가격은 토스가 제공합니다.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# GDELT: 제목·출처·언어·원문 링크만 30분마다 수집합니다. 전문·이미지·자동 번역은 수집하지 않습니다.
# 선택 도메인 필터입니다. 비어 있으면 전체 공개 뉴스에서 관심기업·거시경제 주제를 검색합니다.
GDELT_ENABLED=false
GDELT_NEWS_DOMAINS=

# 검토된 콘텐츠 프로필과 정확히 일치하는 공개 HTTPS RSS/Atom URL만 허용합니다.
# 미검토 IR URL은 등록하거나 수집하지 않습니다.
IR_FEED_URLS=
# 사이트 본문으로 저장·표시할 수 있는 공식 피드만 15분마다 수집합니다.
NEWS_RSS_FEEDS=fed-press,fed-speeches,bls-latest,eia-today,eia-press

# worker 조회와 외부 HTTP 요청의 안전 한도
OPENDART_POLL_OVERLAP_DAYS=3
HTTP_TIMEOUT_MS=15000

# 선택적인 로컬 OpenAI 호환 분류기
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3.5:4b-q4_K_M
AI_ENABLED=false
AI_TIMEOUT_MS=120000

# 영문 뉴스 자동 번역: 같은 서버의 로컬 Ollama를 사용합니다.
# 사용 권한이 확인된 제목과 본문 전체를 번역하고, 완료된 기사만 뉴스 화면에 표시합니다.
# 1분마다 제목·요약과 본문을 각각 최대 3건 처리하며 실패 항목은 비공개 상태에서 재시도합니다.
NEWS_TRANSLATION_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
NEWS_TRANSLATION_MODEL=qwen3.5:4b-q4_K_M
NEWS_TRANSLATION_BATCH_SIZE=3
NEWS_TRANSLATION_TIMEOUT_MS=120000

# PM2가 관리하는 로컬 Ollama 실행 환경의 선택적 경로 변경
# OLLAMA_ROOT=/home/laeti/orsem-data/ollama
# OLLAMA_BIN=/home/laeti/orsem-data/ollama/runtime/bin/ollama
# OLLAMA_MODELS=/home/laeti/orsem-data/ollama/models

# PM2가 관리하는 Orsem Node 프로세스의 선택적 Node 24 실행 파일 절대 경로입니다.
# 부팅 스크립트는 자신을 실행한 Node 실행 파일로 이 값을 자동 고정합니다.
# ORSEM_NODE_BIN=/home/laeti/.nvm/versions/node/v24.14.1/bin/node

# 메시지 전송
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CHANNEL_ID=
# DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_IDS=
DISCORD_SERVICE_TOKEN=
ORSEM_INTERNAL_API_URL=http://127.0.0.1:3210/api/v1/bots/discord
DISCORD_POLL_INTERVAL_MS=5000
MESSENGERBOT_PAIRING_TTL_SECONDS=600

# 운영자 검토를 위한 배포 정책 표시 값입니다. 현재 MVP는 이 세 값을
# 권한 통제 수단으로 읽지 않습니다. 실제 실행 시점의 통제는 인증과
# 레코드별 RightsMode 적용으로 이루어집니다.
APP_MODE=PRIVATE
PUBLIC_MARKET_DATA_API=false
PUBLIC_ARTICLE_BODY=false

# SEC recovery: per issuer request budget (recent + history); no paid provider fallback.
SEC_BACKFILL_MAX_REQUESTS=4
SEC_FORM4_ENABLED=true
# GDELT also requires exact publisher policies in APPROVED_GDELT_SOURCE_POLICIES.
GDELT_OVERLAP_MINUTES=10
GDELT_MAX_SPLIT_DEPTH=4
# Existing Alpaca keys do not by themselves grant News/redistribution entitlement.
ALPACA_NEWS_ENABLED=false

# 금융위원회 주식 시세: 한국 기업 시총 상위 20개 (선택 연결)
FSC_API_KEY=
