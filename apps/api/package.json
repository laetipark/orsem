{
  "name": "@orsem/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "admin:create": "ts-node --files src/cli/create-admin.ts",
    "pretest": "npm run build --workspace=@orsem/contracts && npm run build --workspace=@orsem/database",
    "test": "tsc -p tsconfig.json --outDir .test-dist --tsBuildInfoFile .test-dist/.tsbuildinfo && node --test .test-dist/**/*.spec.js",
    "test:unit": "npm run test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@orsem/contracts": "0.1.0",
    "@orsem/database": "0.1.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.5",
    "connect-redis": "^9.0.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.3.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
